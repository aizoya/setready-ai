# SetReady AI environment-variable contract
# Copy to .env.local for local development. Never commit real credentials.

# Google Cloud / Gemini Enterprise Agent Platform
GOOGLE_CLOUD_PROJECT=
# Managed Agents Interactions API currently uses global.
GOOGLE_CLOUD_LOCATION=global
# Optional custom SetReady agent ID. If omitted, the preview Antigravity base agent is used.
GOOGLE_AGENT_ID=
# Configure Google Cloud credentials using the deployment platform's supported secret mechanism.

# ClickHouse deterministic persistence
CLICKHOUSE_HOST=
CLICKHOUSE_DATABASE=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Official ClickHouse MCP runtime
# Deploy/enable the official mcp-clickhouse server and provide its Streamable HTTP /mcp URL.
CLICKHOUSE_MCP_URL=
# Required when the remote mcp-clickhouse server uses static bearer authentication.
CLICKHOUSE_MCP_AUTH_TOKEN=

# Application
NEXT_PUBLIC_APP_NAME=SetReady AI
