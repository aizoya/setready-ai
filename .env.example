# SetReady AI environment-variable contract
# Copy to .env.local for local development. Never commit real credentials.

# Google / Gemini
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=
# Production authentication uses Vercel OIDC + Google Workload Identity Federation.
# Do not create or commit service-account JSON keys.

# Google Cloud Agent Platform / agent runtime
GOOGLE_AGENT_ID=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_DATABASE=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Application
NEXT_PUBLIC_APP_NAME=SetReady AI
