# SetReady AI environment-variable contract
# Copy to .env.local for local development. Never commit real credentials.

# Google / Gemini (Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Configure Google Cloud credentials using the deployment platform's supported identity/secret mechanism.

# Google Cloud Agent Builder / agent runtime
GOOGLE_AGENT_ID=

# ClickHouse MCP runtime on Google Cloud Run
CLICKHOUSE_MCP_URL=https://YOUR_CLOUD_RUN_SERVICE.run.app/mcp
CLICKHOUSE_MCP_AUTH_TOKEN=

# Optional direct ClickHouse connection values (not used by /api/demo)
CLICKHOUSE_HOST=
CLICKHOUSE_DATABASE=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Application
NEXT_PUBLIC_APP_NAME=SetReady AI
